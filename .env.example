# Port the addon server will listen on
PORT=7000

# Required for self-hosting: the address Nuvio/Stremio clients will use to
# reach this server (your public IP/domain, or LAN IP). Without this, the
# addon falls back to a hardcoded placeholder LAN IP and streams won't load.
# Examples: http://203.0.113.10:7000  or  https://sports.example.com
ADDON_URL=

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=
