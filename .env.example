# Port the addon server will listen on
PORT=7000

# Optional: Public base URL of this addon.
# Used to build absolute proxy/manifest URLs (see src/config.js).
# Example (production); leave unset for local dev (auto-detected).
ADDON_URL=https://nuviosports.xyz

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# Optional: Cloudflare Worker proxy URL (e.g., https://nuvio-proxy.yourname.workers.dev)
# If provided, edge scraping (like CDNLive) will be routed through this worker.
CF_PROXY_URL=

# Account authentication. Leave disabled to preserve anonymous/legacy installs.
AUTH_REQUIRED=true
AUTH_DB_DRIVER=sqlite
AUTH_DB_PATH=./data/auth.sqlite
# Required when AUTH_REQUIRED=true. Generate with: openssl rand -hex 32
AUTH_TOKEN_PEPPER=
AUTH_SESSION_TTL_HOURS=168
# 0 means device tokens remain valid until revoked.
AUTH_DEVICE_TOKEN_TTL_DAYS=0
AUTH_PLAYBACK_TTL_MINUTES=30
# Caps rolling playback-grant renewal even while a stream remains active.
AUTH_PLAYBACK_SESSION_TTL_HOURS=12
# auto enables Secure cookies when the configured public host uses HTTPS.
AUTH_COOKIE_SECURE=auto
