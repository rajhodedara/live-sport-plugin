# Port the addon server will listen on
PORT=7000

# Optional: Public base URL of this addon.
# Used to build absolute proxy/manifest URLs (see src/config.js).
# Example (production); leave unset for local dev (auto-detected).
ADDON_URL=https://nuviosports.xyz

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# Optional: Cloudflare Worker proxy URL (e.g., https://nuvio-proxy.yourname.workers.dev)
# If provided, edge scraping (like CDNLive) will be routed through this worker.
CF_PROXY_URL=
