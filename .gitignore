node_modules/
.env
*.log
.DS_Store
scratch/
scratch_pup/
test-scripts/
cloudflared.exe
*.exe

# Build output — fully regenerated by `npm run build` on every deploy.
# Never commit dist/ to avoid merge conflicts on build artifacts.
dist/
# Out-of-place builds: build beside the live tree, then rename it into place
# (docs/MATCHES_CACHE_PATH_CUTOVER.md). Each one carries a copied matches
# cache and the native impit addon, so a single stray `git add -A` would
# commit tens of MB. `dist.next/` is a staged build, `dist.prev*` is a parked
# or previous tree (the workflow parks it as plain `dist.prev`).
dist.next/
dist.prev*/

# Runtime-generated team logo cache (TeamLogoService writes this in place).
# The tracked seed lives in src/data/team_logos_cache.json.
*team_logos_cache.json
*matches_cache.json

# Jest run output logs (debug/baseline snapshots, not source)
after-jest.txt
baseline-jest.txt
current-jest.txt
final-jest.txt
v2.txt
v3.txt
v4.txt
verify.txt
jest.log

# Runtime caches written by the running process. Never tracked: the deploy runs
# `git reset --hard HEAD`, so a tracked runtime cache is wiped on every deploy.
/data/
/caches/

# Benchmark outputs
benchmarks/results/*.md
benchmarks/results/*.json
!benchmarks/results/forensic-audit-report.md
!benchmarks/results/regression-analysis.md
!benchmarks/results/change-summary.md
!benchmarks/results/raw-forensic-audit.json
!benchmarks/results/final-production-readiness.md

# Server runtime process configuration (managed per-host, never tracked)
ecosystem.config.js

# Temporary raw public catalog dumps
public/*.json



.zcode/
.timezone-data/
